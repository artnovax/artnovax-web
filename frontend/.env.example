# Supabase still powers dynamic collections, forms, waitlists, payments and /admin.
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEYS

# Static-first public pages. Left false in production unless we
# want public page copy/hero settings to be read from page_sections on every load.
# /admin remains connected to the CMS regardless of this setting.
REACT_APP_ENABLE_PAGE_CMS=false
