# Supabase powers public content, forms, waitlists and the /admin CMS.
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Temporary legacy backend: only checkout/payments/donations still use it.
# Set this to the deployed FastAPI URL when those features are enabled.
REACT_APP_BACKEND_URL=http://localhost:8001
WDS_SOCKET_PORT=3000
