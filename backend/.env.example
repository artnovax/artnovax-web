MONGO_URL="mongodb://localhost:27017"
DB_NAME="artnovax"
CORS_ORIGINS="http://localhost:3000"

# Required for /api/admin/* routes. Use a strong random value.
ADMIN_TOKEN="replace-with-a-strong-random-token"

# Optional integrations
RESEND_API_KEY=""
FROM_EMAIL="ArtNovaX <onboarding@resend.dev>"
TEAM_EMAIL="you@example.com"

PUBLIC_ORIGIN="http://localhost:3000"
# Public URL used inside transactional email. In production, set this to your deployed logo URL.
BRAND_LOGO_URL="http://localhost:3000/images/artnovax-wordmark.png"

# One-time Mongo -> Supabase migration only. Never expose the service role key to React.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
